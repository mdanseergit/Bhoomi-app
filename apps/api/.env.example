# ---------------------------------------------------------------------------
# BHOOMI API - example environment
#
# Copy to `.env` and fill in real values. Never commit the filled-in file.
# Every value below is a placeholder with no credentials in it.
# ---------------------------------------------------------------------------

# Runtime
# "production" enables strict validation: simulated data sources and
# unvalidated models are refused at startup.
APP_ENV=development
DEBUG=true
APP_NAME=BHOOMI API

# Secrets — generate a strong random value for production, never reuse a
# development secret. Minimum 32 characters in production.
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Database and cache
DATABASE_URL=postgresql+psycopg://bhoomi:password@localhost:5432/bhoomi
REDIS_URL=redis://localhost:6379/0

# Comma-separated browser origins allowed to call the API.
# Must not contain localhost in production.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# AI explanation provider (optional)
#
# Leave NVIDIA_API_KEY empty to run fully offline. BHOOMI then uses its
# deterministic agriculture rules, which state only what recorded data supports.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model routing. The first model that returns a valid, non-empty response wins.
# AI_MODEL_CHAIN overrides both model fields when set.
AI_PRIMARY_MODEL=meta/llama-3.2-11b-vision-instruct
AI_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct
AI_PROVIDER_ORDER=deterministic
AI_REQUEST_TIMEOUT_SECONDS=12
AI_MAX_ATTEMPTS=2
AI_MAX_TOKENS_OUT=700

# ---------------------------------------------------------------------------
# Data sources (optional)
#
# When a source is unconfigured, the feature reports that it is unavailable
# rather than producing a value. BHOOMI never fabricates observations.
# ---------------------------------------------------------------------------

# Weather. Requires both values; district observations and forecasts.
IMD_API_BASE_URL=
IMD_API_KEY=
# "none" disables the fallback provider entirely.
WEATHER_FALLBACK_PROVIDER=none

# Satellite / vegetation indices. "none" means no observations are available.
SATELLITE_PROVIDER=none
SATELLITE_API_KEY=
SATELLITE_API_BASE_URL=

# Crop Doctor image diagnosis.
# "none" disables the feature. Any other name must resolve to a validated
# model or startup fails in production.
DISEASE_MODEL_PROVIDER=none
