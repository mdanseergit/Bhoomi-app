# ---------------------------------------------------------------------------
# BHOOMI API — Production Environment Variables
#
# Copy this file and set values for your deployment platform.
# For Render: set these in the Render dashboard or render.yaml.
# For Docker: pass as --env-file .env.production
# ---------------------------------------------------------------------------

APP_ENV=production
DEBUG=false
APP_NAME=BHOOMI Agriculture Intelligence Platform

# ── Security ──────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_64_char_random_string

# ── Database ──────────────────────────────────────────────────────────
# Supabase connection string (with pgvector and PostGIS extensions)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Redis (optional - in-memory fallback enabled if empty) ────────────
# REDIS_URL=redis://red-xxxx:6379

# ── CORS ──────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL (no trailing slash, comma-separated for multiple)
CORS_ALLOWED_ORIGINS=https://bhoomi-app-five.vercel.app,https://bhoomi-app-mdanseergits-projects.vercel.app
CORS_ORIGINS=https://bhoomi-app-five.vercel.app

# ── AI Provider (optional) ────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your-production-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PRIMARY_MODEL=meta/llama-3.2-11b-vision-instruct
AI_FALLBACK_MODEL=meta/llama-3.2-11b-vision-instruct
AI_PROVIDER_ORDER=nvidia,deterministic
AI_REQUEST_TIMEOUT_SECONDS=12
AI_MAX_ATTEMPTS=2
AI_MAX_TOKENS_OUT=700

# ── Data Sources ──────────────────────────────────────────────────────
SATELLITE_PROVIDER=none
DISEASE_MODEL_PROVIDER=none
WEATHER_FALLBACK_PROVIDER=none

# ── Storage ───────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./var/uploads
MAX_UPLOAD_SIZE_MB=8

# ── Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
