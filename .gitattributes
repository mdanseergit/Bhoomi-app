# Normalise line endings so Windows and Linux contributors get identical
# checkouts and diffs.
* text=auto eol=lf

*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.mako text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.css text eol=lf

# Keep image assets byte-identical.
*.jpeg binary
*.jpg binary
*.png binary
*.gif binary
*.webp binary
*.ico binary

# Lockfiles and generated manifests.
package-lock.json -diff linguist-generated=true
